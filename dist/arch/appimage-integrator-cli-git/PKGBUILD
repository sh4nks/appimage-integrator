pkgname=appimage-integrator-cli-git
pkgver=0.1.0.r1.g7b7964d
pkgrel=1
pkgdesc="Integrate AppImages into the desktop (command line tool and folder watcher)"
arch=(x86_64 aarch64)
url="https://github.com/sh4nks/appimage-integrator"
license=(MIT)
depends=(gcc-libs glibc)
makedepends=(cargo git)
optdepends=('libnotify: desktop notifications for available updates')
provides=(appimage-integrator-cli)
conflicts=(appimage-integrator-cli appimage-integrator)
options=(!lto !debug)
source=("$pkgname::git+$url.git")
sha256sums=(SKIP)

pkgver() {
  cd "$pkgname"
  local version
  version="$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)"
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p appimage-integrator
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/appimage-integrator -t "$pkgdir/usr/bin"
  install -Dm644 dist/appimage-integrator.service dist/appimage-integrator-update.service \
    dist/appimage-integrator-update.timer -t "$pkgdir/usr/lib/systemd/user"
  install -Dm644 dist/config.example.toml -t "$pkgdir/usr/share/doc/appimage-integrator"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
